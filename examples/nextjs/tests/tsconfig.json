{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "../.test-build",
        "rootDir": "..",
        "noEmit": false,
        "incremental": false,
        "jsx": "react-jsx",
        "plugins": [],
        "rewriteRelativeImportExtensions": true
    },
    "include": [
        "../lib/**/*.ts",
        "../app/components/**/*.tsx",
        "../app/error.tsx"
    ],
    "exclude": ["../node_modules"]
}
