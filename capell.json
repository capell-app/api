{
    "manifest-version": 3,
    "name": "capell-app/api",
    "slug": "api",
    "displayName": "API",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Lets a separate website or mobile app read your published Capell pages, and can tell it when to refresh.",
    "product": {
        "group": "Capell Publishing",
        "tier": "free",
        "bundle": "publishing"
    },
    "namespace": "Capell\\Api",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/layout-builder"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Api\\Providers\\ApiServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "route",
            "class": "Capell\\Api\\Manifest\\ApiRoutesContribution",
            "routes": [
                "capell-api.v1.pages.resolve",
                "capell-api.v1.pages",
                "capell-api.v1.resolve",
                "capell-api.v1.collections",
                "capell-api.v1.search",
                "capell-api.v1.navigation",
                "capell-api.v1.media"
            ],
            "prefix": "api",
            "middleware": ["api", "throttle:capell-api"],
            "apiEndpoints": [
                {
                    "type": "public-api-endpoint",
                    "name": "public-page-resolve-v1",
                    "routeName": "capell-api.v1.pages.resolve",
                    "method": "GET",
                    "path": "/api/capell/v1/pages/resolve",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": false,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-pages",
                    "routeName": "capell-api.v1.pages",
                    "method": "GET",
                    "path": "/api/v1/pages",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-resolve",
                    "routeName": "capell-api.v1.resolve",
                    "method": "GET",
                    "path": "/api/v1/pages/resolve",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-collections",
                    "routeName": "capell-api.v1.collections",
                    "method": "GET",
                    "path": "/api/v1/collections/{type}",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-search",
                    "routeName": "capell-api.v1.search",
                    "method": "GET",
                    "path": "/api/v1/search",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-navigation",
                    "routeName": "capell-api.v1.navigation",
                    "method": "GET",
                    "path": "/api/v1/navigation",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-media",
                    "routeName": "capell-api.v1.media",
                    "method": "GET",
                    "path": "/api/v1/media",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                }
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\Api\\Health\\ApiHealthCheck"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["public-page-api", "public-page-api-v1"],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": [
                "GET /api/capell/v1/pages/resolve (capell-api.v1.pages.resolve)",
                "GET /api/v1/collections/{type} (capell-api.v1.collections)",
                "GET /api/v1/media (capell-api.v1.media)",
                "GET /api/v1/navigation (capell-api.v1.navigation)",
                "GET /api/v1/pages (capell-api.v1.pages)",
                "GET /api/v1/pages/resolve (capell-api.v1.resolve)",
                "GET /api/v1/search (capell-api.v1.search)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /api/capell/v1/pages/resolve (capell-api.v1.pages.resolve)",
                "GET /api/v1/collections/{type} (capell-api.v1.collections)",
                "GET /api/v1/media (capell-api.v1.media)",
                "GET /api/v1/navigation (capell-api.v1.navigation)",
                "GET /api/v1/pages (capell-api.v1.pages)",
                "GET /api/v1/pages/resolve (capell-api.v1.resolve)",
                "GET /api/v1/search (capell-api.v1.search)"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": ["Capell\\Api\\Jobs\\DeliverRevalidationWebhookJob"]
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["api"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\PageUrl",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Site",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "api.package-health",
            "label": "API route, middleware, and response header diagnostics are discoverable by Diagnostics.",
            "class": "Capell\\Api\\Health\\ApiHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Share published pages with a separate front end or app, and let it know when editors publish.",
        "description": "Keep Capell as the place where editors write, and let another site or app do the displaying. Your developer gets read-only access to live pages, fetched singly, filtered by page type, searched by title or browsed as a directory. Lists return a page's address, title and cleaned content, and media entries carry an address, description and file type. Looking a page up by address can also return its page details and layout when asked. A rate limit protects the site, and previews of unpublished work need a personal key. A TypeScript starter and a Next.js example are included for developers.",
        "problem": "I can't get my published pages out of Capell and into a separate front end without custom work.",
        "outcome": "Your own front end shows published Capell pages and can refresh when editors publish.",
        "faq": [
            {
                "question": "Can the separate website or app change my pages?",
                "answer": "No. The access is read-only and the package adds no admin screen. Your editors keep working in Capell as they do now."
            },
            {
                "question": "Will my draft pages show up on the separate website?",
                "answer": "No. Only pages that are live today are returned. Your developer can see drafts by using a personal key made for previewing."
            },
            {
                "question": "How many pages come back when the website asks for a list?",
                "answer": "Twenty at a time by default, and up to a hundred. Each list points to the next batch if there is one."
            },
            {
                "question": "Can my front end find out when a page has changed?",
                "answer": "Yes, once your developer has added the front end's address and a secret. When a page is saved or deleted, Capell sends a signed message through your background queue naming the site and page."
            }
        ],
        "screenshots": [
            {
                "path": "docs/screenshots/nextjs-starter-home.png",
                "alt": "Home page titled Notes from Harbour Studio, with an introduction and a card linking to five published pages.",
                "caption": "A separate Next.js website built from the starter shows a Capell home page and links to the pages it reads from the API."
            },
            {
                "path": "docs/screenshots/nextjs-starter-directory.png",
                "alt": "Page titled Browse published pages, with a count of nine pages and a list of their titles and addresses.",
                "caption": "The starter lists every published page the API returns, so a new page appears on the website without a code change."
            },
            {
                "path": "docs/screenshots/nextjs-starter-article.png",
                "alt": "Article titled Choosing the right desk for your project, with an introduction and short sections under headings.",
                "caption": "A page's blocks come back from the API as headings and text, and the starter lays them out as an article."
            },
            {
                "path": "docs/screenshots/page-resolve-success-json.png",
                "alt": "Browser window of formatted data for a home page, with its web address, a title and one line of text.",
                "caption": "This is what a separate website receives when it asks for a published page by its address."
            },
            {
                "path": "docs/screenshots/page-resolve-layout-json.png",
                "alt": "Browser window of formatted data for a page, listing its layout, one block and the heading and text inside it.",
                "caption": "A page's layout comes back as blocks and their text, so the front end can arrange them itself."
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Card with two large empty browser frames of tiny text above three small step boxes.",
                "caption": "The card presents the package as published page data served for other websites to read."
            }
        ],
        "categories": ["frontend", "publishing-pro"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
