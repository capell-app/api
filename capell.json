{
    "manifest-version": 3,
    "name": "capell-app/api",
    "slug": "api",
    "displayName": "API",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Supported v1 content API with cursor-paginated pages, collections, preview tokens and signed revalidation webhooks.",
    "product": {
        "group": "Capell Publishing",
        "tier": "free",
        "bundle": "publishing"
    },
    "namespace": "Capell\\Api",
    "surfaces": ["frontend"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/layout-builder"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": ["Capell\\Api\\Providers\\ApiServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "route",
            "class": "Capell\\Api\\Manifest\\ApiRoutesContribution",
            "routes": [
                "capell-api.pages.resolve",
                "capell-api.v1.pages.resolve",
                "capell-api.v1.pages",
                "capell-api.v1.resolve",
                "capell-api.v1.collections",
                "capell-api.v1.search",
                "capell-api.v1.navigation",
                "capell-api.v1.media"
            ],
            "prefix": "api",
            "middleware": ["api", "throttle:capell-api"],
            "apiEndpoints": [
                {
                    "type": "public-api-endpoint",
                    "name": "public-page-resolve-v1",
                    "routeName": "capell-api.v1.pages.resolve",
                    "method": "GET",
                    "path": "/api/capell/v1/pages/resolve",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": false,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "public-page-resolve-legacy",
                    "routeName": "capell-api.pages.resolve",
                    "method": "GET",
                    "path": "/api/capell/pages/resolve",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": false,
                    "compatibility": "legacy",
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-pages",
                    "routeName": "capell-api.v1.pages",
                    "method": "GET",
                    "path": "/api/v1/pages",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-resolve",
                    "routeName": "capell-api.v1.resolve",
                    "method": "GET",
                    "path": "/api/v1/pages/resolve",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-collections",
                    "routeName": "capell-api.v1.collections",
                    "method": "GET",
                    "path": "/api/v1/collections/{type}",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-search",
                    "routeName": "capell-api.v1.search",
                    "method": "GET",
                    "path": "/api/v1/search",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-navigation",
                    "routeName": "capell-api.v1.navigation",
                    "method": "GET",
                    "path": "/api/v1/navigation",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                },
                {
                    "type": "public-api-endpoint",
                    "name": "headless-v1-media",
                    "routeName": "capell-api.v1.media",
                    "method": "GET",
                    "path": "/api/v1/media",
                    "version": "v1",
                    "auth": "public",
                    "readOnly": true,
                    "canonical": true,
                    "signedContextParameters": ["site", "language"],
                    "publicSafety": [
                        "sanitized-html",
                        "no-authoring-surface",
                        "no-secrets"
                    ]
                }
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\Api\\Health\\ApiHealthCheck"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": [
        "public-page-api",
        "public-page-api-v1",
        "cursor-pagination",
        "token-preview",
        "revalidation-webhooks"
    ],
    "security": {
        "riskTier": "critical",
        "publicSurface": {
            "routeNames": [
                "GET /api/capell/pages/resolve (capell-api.pages.resolve)",
                "GET /api/capell/v1/pages/resolve (capell-api.v1.pages.resolve)",
                "GET /api/v1/collections/{type} (capell-api.v1.collections)",
                "GET /api/v1/media (capell-api.v1.media)",
                "GET /api/v1/navigation (capell-api.v1.navigation)",
                "GET /api/v1/pages (capell-api.v1.pages)",
                "GET /api/v1/pages/resolve (capell-api.v1.resolve)",
                "GET /api/v1/search (capell-api.v1.search)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /api/capell/pages/resolve (capell-api.pages.resolve)",
                "GET /api/capell/v1/pages/resolve (capell-api.v1.pages.resolve)",
                "GET /api/v1/collections/{type} (capell-api.v1.collections)",
                "GET /api/v1/media (capell-api.v1.media)",
                "GET /api/v1/navigation (capell-api.v1.navigation)",
                "GET /api/v1/pages (capell-api.v1.pages)",
                "GET /api/v1/pages/resolve (capell-api.v1.resolve)",
                "GET /api/v1/search (capell-api.v1.search)"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": ["Capell\\Api\\Jobs\\DeliverRevalidationWebhookJob"]
        },
        "adminSurface": {
            "authorization": "none",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 0,
        "cacheTags": ["api", "api:pages"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\PageUrl",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Site",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "api.package-health",
            "label": "API route, middleware, and response header diagnostics are discoverable by Diagnostics.",
            "class": "Capell\\Api\\Health\\ApiHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Supported v1 content API with cursor-paginated pages, collections, preview tokens and signed revalidation webhooks.",
        "problem": "Our headless frontend cannot retrieve published pages without a custom integration.",
        "outcome": "A separate frontend can consume published page content without receiving draft or authoring state.",
        "faq": [
            {
                "question": "What content can a headless client retrieve?",
                "answer": "Resolve and list published pages, filter collections by page type, search titles and retrieve a paginated page directory and public content images through the supported v1 API."
            },
            {
                "question": "Are draft pages included in responses?",
                "answer": "Public reads exclude drafts. Server-side Sanctum tokens with explicit preview and site abilities can request sanitised preview content."
            },
            {
                "question": "Can clients use it to edit pages?",
                "answer": "The declared endpoints are public and read-only."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-page-resolve-success-json.png",
                "alt": "JSON response returned for a published page",
                "caption": "JSON response returned for a published page"
            },
            {
                "path": "docs/assets/marketplace/listing-page-resolve-layout-json.png",
                "alt": "JSON response describing a page layout and the areas it contains",
                "caption": "JSON response describing a page layout and the areas it contains"
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "API extension preview image",
                "caption": "API extension preview"
            }
        ],
        "categories": ["frontend", "publishing-pro"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
