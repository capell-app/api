# Exclude test directory from composer distributions
/tests export-ignore
/docs/screenshots/* export-ignore

# The two page capture images listed in the Marketplace gallery ship with the package.
/docs/screenshots/page-resolve-success-json.png -export-ignore
/docs/screenshots/page-resolve-layout-json.png -export-ignore

# SDK test fixtures are source evidence, not Composer runtime assets.
/sdk/tests export-ignore
/sdk/fixtures export-ignore

# The Next.js example's own tests are source evidence, not Composer runtime assets.
/examples/nextjs/tests export-ignore
